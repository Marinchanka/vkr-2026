digraph G {
graph [bgcolor="white", fontname="DejaVu Sans", fontsize=12, pad=.25, nodesep=.38, ranksep=.50, dpi=170];
node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#f5f5f5", color="#454545", margin=".14,.08"];
edge [fontname="DejaVu Sans", fontsize=10, color="#444444", arrowsize=.75];
rankdir=TB;
start [shape=circle,label="",width=.17,style=filled,fillcolor=black];
rules [label="Правила: поиск кандидатов"];
r [shape=diamond,label="Однозначно и\nсовместимо?"];
emb [label="Векторное сопоставление\nс контекстом"];
e [shape=diamond,label="Порог, разрыв и\nсовместимость достаточны?"];
allow [shape=diamond,label="LLM разрешена,\nдоступна и бюджет есть?"];
llm [label="LLM: оценка кандидатов"];
l [shape=diamond,label="Ответ допустим и\nпринят по критериям?"];
review [label="Сохранить кандидатов\nна ручную проверку"];
decision [shape=diamond,label="Решение\nоператора?"];
fix [label="Выбрать или исправить\nцелевой атрибут"];
approved [label="Сохранить подтверждённое\nсоответствие и метод"];
skip [label="Зафиксировать отсутствие\nсоответствия"];
merge [shape=point,width=.03,label=""];
next [shape=diamond,label="Есть ещё\nатрибуты?"];
end [shape=doublecircle,label="",width=.2,style=filled,fillcolor=black];
start -> rules -> r;
r -> merge [label="да"];
r -> emb [label="нет"];
emb -> e;
e -> merge [label="да"];
e -> allow [label="нет"];
allow -> llm [label="да"];
allow -> review [label="нет"];
llm -> l;
l -> merge [label="да"];
l -> review [label="нет"];
review -> decision;
decision -> merge [label="подтвердить"];
decision -> fix [label="исправить"];
fix -> merge;
decision -> skip [label="отклонить"];
merge -> approved;
approved -> next;
skip -> next;
next -> rules [label="да",constraint=false];
next -> end [label="нет"];
}
